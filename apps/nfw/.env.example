# Local development (services from docker-compose.yml at the repository root).
# On Upsun these values come from .environment instead.
APP_NAME="Aurora NFW"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_LOCALE=it

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nfw
DB_USERNAME=nfw
DB_PASSWORD=nfw

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=nfw:
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

KAFKA_BROKERS=127.0.0.1:19092
PROMOTIONS_URL=http://127.0.0.1:8003
OMS_URL=http://127.0.0.1:8002
COMMISSION_COMPLEXITY=200
HORIZON_COMMISSION_PROCESSES=8
